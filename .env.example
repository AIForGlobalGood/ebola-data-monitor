# LLM synthesis (optional — mock mode works without keys)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/crisis_hub.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Vercel (optional — set in project env vars)
# CRON_SECRET=generate-a-random-string
# LLM keys as above

# Frontend split deploy (optional — leave empty when API is same-origin on Vercel)
# VITE_API_BASE=https://your-backend.example.com
