# Copy to backend/.env for local development (optional Turso replica)
# DATABASE_URL=sqlite:///./data/crisis_hub.db

# Turso — persistent production database (embedded replica syncs to cloud)
# Create with: ./scripts/setup_turso.sh
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your-token

# Vercel Cron auth (recommended in production)
# CRON_SECRET=random-string

# Drop indexed articles published before this date (YYYY-MM-DD)
# MIN_PUBLISHED_DATE=2026-01-01

# LLM synthesis (optional)
# LLM_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
